{
  "name": "@testagram/api-contracts",
  "version": "1.0.0",
  "private": true,
  "description": "Testagram OpenAPI contracts and typed client foundations",
  "type": "module",
  "scripts": {
    "lint:openapi": "redocly lint contracts/openapi/testagram-v1.yaml",
    "bundle:openapi": "redocly bundle contracts/openapi/testagram-v1.yaml -o dist/openapi.yaml",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test",
    "check": "npm run lint:openapi && npm run typecheck && npm test && npm run audit:backend-routes",
    "audit:backend-routes": "node scripts/check-backend-route-contract.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "^1.34.5",
    "typescript": "^5.8.3",
    "tsx": "^4.19.3"
  }
}
